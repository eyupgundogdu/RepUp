{
  "name": "repup-frontend",
  "private": true,
  "description": "Front-end build for RepUp: compiles Tailwind CSS into src/main/resources/static/css/app.css",
  "scripts": {
    "build:css": "tailwindcss -i src/main/frontend/app.css -o src/main/resources/static/css/app.css --minify",
    "watch:css": "tailwindcss -i src/main/frontend/app.css -o src/main/resources/static/css/app.css --watch"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
